<?xml version="1.0" encoding="utf-8"?>
<!--
  Regras de extração de dados para Android 12+ (API 31+).

  Exclui o banco de notificações, que contém textos de notificações
  financeiras (dados sensíveis), tanto do backup em nuvem (cloud-backup)
  quanto da transferência entre dispositivos (device-transfer).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="notification_db" />
        <exclude domain="database" path="notification_db-shm" />
        <exclude domain="database" path="notification_db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="notification_db" />
        <exclude domain="database" path="notification_db-shm" />
        <exclude domain="database" path="notification_db-wal" />
    </device-transfer>
</data-extraction-rules>
