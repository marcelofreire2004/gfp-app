<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clipToPadding="false"
    android:paddingTop="?attr/actionBarSize">

    <!-- paddingTop reserva a altura da ActionBar para o conteúdo nunca ficar
         sob a barra (corrige a sobreposição observada). O título "Despesas"
         é exibido na ActionBar (definido na Activity). -->

    <!-- Resumo (RF08): considera somente lançamentos confirmados. -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/txtSummaryConfirmed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="Confirmadas: R$ 0,00"/>

            <TextView
                android:id="@+id/txtSummaryReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Em revisão: 0"/>

            <TextView
                android:id="@+id/txtSummaryByCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/txtSummaryByCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnManageCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gerenciar cartões"
        android:layout_marginHorizontal="16dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerExpenses"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"/>

</LinearLayout>
