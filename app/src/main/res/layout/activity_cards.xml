<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    android:paddingTop="?attr/actionBarSize"
    android:clipToPadding="false">

    <!-- Espaçador para dar respiro abaixo da ActionBar (overlay). -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="12dp"/>

    <EditText
        android:id="@+id/editCardName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nome de identificação"
        android:inputType="text"/>

    <EditText
        android:id="@+id/editCardInstitution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Instituição (ex.: Nubank)"
        android:inputType="text"/>

    <EditText
        android:id="@+id/editCardNickname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Apelido (opcional)"
        android:inputType="text"/>

    <EditText
        android:id="@+id/editCardLast4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Últimos 4 dígitos (opcional)"
        android:inputType="number"
        android:maxLength="4"/>

    <EditText
        android:id="@+id/editCardDueDay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Dia de vencimento (1-31)"
        android:inputType="number"
        android:maxLength="2"/>

    <EditText
        android:id="@+id/editCardClosingDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Dias para fechamento antes do vencimento"
        android:inputType="number"
        android:maxLength="2"/>

    <Button
        android:id="@+id/btnAddCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Adicionar cartão"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCards"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"/>

</LinearLayout>
