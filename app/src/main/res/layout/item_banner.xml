<?xml version="1.0" encoding="utf-8"?>
<!-- Root preenche o ViewPager2 (match_parent, sem margem). O respiro lateral
     vem do padding do próprio FrameLayout. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp">

    <LinearLayout
        android:id="@+id/bannerRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="20dp"
        android:background="@drawable/bg_rounded_banner">

        <TextView
            android:id="@+id/txtBannerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gfp_on_primary"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtBannerSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gfp_on_primary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

</FrameLayout>
