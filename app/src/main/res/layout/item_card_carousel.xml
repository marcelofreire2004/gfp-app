<?xml version="1.0" encoding="utf-8"?>
<!-- O root DEVE preencher o ViewPager2 (match_parent). A aparência de "card"
     com respiro vem do padding/altura dos filhos internos. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingVertical="4dp">

    <!-- Estado: CARTÃO cadastrado -->
    <LinearLayout
        android:id="@+id/cardContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@drawable/bg_card_item">

        <TextView
            android:id="@+id/txtCarouselInstitution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gfp_on_primary"
            android:textSize="14sp"
            android:alpha="0.9"/>

        <TextView
            android:id="@+id/txtCarouselName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gfp_on_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"/>

        <!-- Valor da fatura atual -->
        <TextView
            android:id="@+id/txtCarouselInvoiceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fatura atual"
            android:textColor="@color/gfp_on_primary"
            android:textSize="11sp"
            android:alpha="0.85"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/txtCarouselInvoice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gfp_on_primary"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/txtCarouselLast4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gfp_on_primary"
            android:textSize="16sp"
            android:letterSpacing="0.2"/>

        <!-- Fechamento e vencimento lado a lado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/txtCarouselClosing"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/gfp_on_primary"
                android:textSize="12sp"
                android:alpha="0.9"/>

            <TextView
                android:id="@+id/txtCarouselDue"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/gfp_on_primary"
                android:textSize="12sp"
                android:gravity="end"
                android:alpha="0.9"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Estado: ADICIONAR cartão (quando não há cartões) -->
    <LinearLayout
        android:id="@+id/addContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_card_add"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            android:textColor="@color/gfp_primary"
            android:textSize="36sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adicionar cartão"
            android:textColor="@color/gfp_primary"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>

</FrameLayout>
