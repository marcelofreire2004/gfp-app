<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gfp_bg"
    android:clipToPadding="false"
    android:paddingTop="?attr/actionBarSize">

    <!-- Cabeçalho da fatura -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtInvoiceCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gfp_on_primary"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fatura atual"
            android:textColor="@color/gfp_on_primary"
            android:textSize="12sp"
            android:alpha="0.85"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/txtInvoiceTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gfp_on_primary"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtInvoiceDates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gfp_on_primary"
            android:textSize="13sp"
            android:alpha="0.9"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lançamentos"
        android:textColor="@color/gfp_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_margin="16dp"/>

    <TextView
        android:id="@+id/txtInvoiceEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nenhum lançamento nesta fatura."
        android:textColor="@color/gfp_text_muted"
        android:layout_marginHorizontal="16dp"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerInvoice"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</LinearLayout>
